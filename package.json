{
  "name": "guildmanagement",
  "version": "3.35.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "FGF Guild Management — TypeScript front end built by Vite, on Supabase (Postgres + Deno Edge Functions)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "build:pdf": "node scripts/generate-compliance-pdf.js",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "setup:hooks": "bash scripts/setup-hooks.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.62.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "25.0.1",
    "serve": "14.2.6",
    "subset-font": "^2.9.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@sentry/browser": "^10.75.0",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "zod": "^3.23.8"
  }
}
