# Template for /etc/fgf-discord-bot/env (root-owned, mode 600).
# setup.sh copies this file there the first time; fill it ON THE VM with
#   sudo nano /etc/fgf-discord-bot/env
# Never commit real values. Copy them from the Render dashboard (Environment)
# or from their source (Discord Developer Portal, Supabase dashboard).
# No quotes, no spaces around "=".

# Required
DISCORD_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VERIFICATION_FUNCTION_URL=
# Must be byte-identical to the DISCORD_WORKER_SECRET Edge Function secret.
DISCORD_WORKER_SECRET=

# Optional
DISCORD_MEMBER_ROLE_ID=
# Only "true" once "Server Members Intent" is ON in the Discord Developer
# Portal, otherwise the bot cannot log in at all.
DISCORD_GUILD_MEMBERS_INTENT=

# Health listener, local only (the VM firewall blocks inbound traffic).
PORT=3000

# Optional: a Better Stack (or any) heartbeat URL. When set, a timer pings it
# every 5 minutes while the bot is connected to Discord, so a silent outage
# raises an alert.
HEARTBEAT_URL=
