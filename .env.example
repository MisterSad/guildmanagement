# Sentry DSN for client-side crash reporting & APM (optional).
# Consumed by src/core/config/constants.ts (SENTRY_DSN). Leave empty to disable.
VITE_SENTRY_DSN=

# NOTE: the Supabase URL and publishable key are NOT environment variables.
# They are compile-time constants in src/core/config/constants.ts, because the
# client must be built there and wrapped in the multi-tenant write guard
# (installDbWriteGuard) before any service runs. VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY were advertised here for a code path that could never
# execute; rotating the key is a code change, by design.
