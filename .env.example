# Local dev only. Real values live in Supabase secrets (edge functions)
# and are never committed. See docs/DEPLOY_RUNBOOK.md.

# Google Gemini Vision API (OCR roster import — supabase/functions/ocr-guild-members)
GEMINI_API_KEY=

# Supabase project (edge functions runtime — set via `supabase secrets set`)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (supabase/functions/gm-create-order, gm-order-status, gm-stripe-webhook, member-portal)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_ENV=prod

# Web Push (supabase/functions/event-reminders)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Discord (supabase/functions/tickets)
TICKET_WEBHOOK_URL=

# Note: the pg_cron → event-reminders trigger secret lives in Supabase Vault,
# not as an env var (see supabase/migrations/20260823063000_cron_secret_to_vault.sql).
