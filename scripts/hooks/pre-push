#!/usr/bin/env bash
# .git/hooks/pre-push
#
# Auto-deploy Supabase Edge Functions when pushing to main.
#
# Logic:
#   1. Only activates on pushes targeting the 'main' branch.
#   2. Collects all changed files across every commit being pushed.
#   3. If ANY file under supabase/functions/_shared/ was changed → deploy ALL
#      functions (safe, atomic: guarantees every function gets the latest shared
#      code and avoids the "version drift" bug that caused Discord link to fail).
#   4. Otherwise → deploy only the individual functions whose own index.ts
#      was changed.
#   5. If no function files changed at all → skip silently (no-op).
#
# Exit codes:
#   0  → push proceeds (deploy succeeded or nothing to deploy)
#   1  → deploy failed (push is BLOCKED to avoid pushing broken state)
#
# Requires: npx supabase (project already linked via supabase link)
#
# NOTE ON verify_jwt — do not add `--no-verify-jwt` back.
#   This hook used to pass that flag on every single deploy, forcing
#   verify_jwt = false onto ALL functions regardless of what
#   `supabase/config.toml` declares. That is the root cause of audit finding M1:
#   `admin-accounts` -- the role provisioner -- ran publicly while both
#   config.toml and ARCHITECTURE.md said it was JWT-gated. Seven functions are
#   declared `verify_jwt = true`, and the blanket flag would have made every one
#   of them public again on the next push to main.
#   Without the flag the CLI reads the per-function value from config.toml,
#   which is where that decision belongs. `tests/deploy_hook.test.js` fails if
#   the flag comes back.

set -euo pipefail

REMOTE="$1"   # remote name (e.g. "origin")
# $2 is the remote URL — unused here but available

MAIN_BRANCH="main"
FUNCTIONS_DIR="supabase/functions"
SHARED_DIR="${FUNCTIONS_DIR}/_shared"

# ── 1. Collect pushed commits ────────────────────────────────────────────────
# Read from stdin: "<local-sha> <local-ref> <remote-sha> <remote-ref>"
CHANGED_FILES=""
while read local_sha local_ref remote_sha remote_ref; do
  # Only process pushes to main.
  #
  # This tests the REMOTE ref, not the local one. It used to test $local_ref,
  # which is the branch name on this side -- so `git push origin HEAD:main`,
  # and every push from a worktree whose branch is not literally named "main",
  # updated production while silently skipping the deploy. That is precisely
  # the code-vs-deployed drift this hook exists to prevent. What matters is
  # where the commits land, which is $remote_ref.
  if [[ "$remote_ref" != "refs/heads/${MAIN_BRANCH}" ]]; then
    continue
  fi

  # Determine the range of commits being pushed
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # First push to this branch — diff against the initial empty tree
    RANGE="$local_sha"
    FILES=$(git diff-tree --no-commit-id -r --name-only "$RANGE" 2>/dev/null || true)
  else
    RANGE="${remote_sha}..${local_sha}"
    FILES=$(git diff --name-only "$RANGE" 2>/dev/null || true)
  fi

  CHANGED_FILES="${CHANGED_FILES}${FILES}"$'\n'
done

# Nothing targeted main → skip
if [[ -z "${CHANGED_FILES// /}" ]]; then
  exit 0
fi

# ── 2. Detect which functions are affected ───────────────────────────────────
DEPLOY_ALL=false
DEPLOY_FUNCTIONS=()

while IFS= read -r f; do
  [[ -z "$f" ]] && continue

  # _shared/ touched → must redeploy everything
  if [[ "$f" == ${SHARED_DIR}/* ]]; then
    DEPLOY_ALL=true
    break
  fi

  # Individual function index.ts changed
  if [[ "$f" == ${FUNCTIONS_DIR}/*/index.ts ]]; then
    # Extract function name (the directory between functions/ and /index.ts)
    fn_name=$(echo "$f" | sed "s|${FUNCTIONS_DIR}/||" | cut -d'/' -f1)
    if [[ "$fn_name" != "_shared" ]]; then
      DEPLOY_FUNCTIONS+=("$fn_name")
    fi
  fi
done <<< "$CHANGED_FILES"

# ── 3. Nothing to deploy ─────────────────────────────────────────────────────
if [[ "$DEPLOY_ALL" == false && "${#DEPLOY_FUNCTIONS[@]}" -eq 0 ]]; then
  exit 0
fi

# ── 4. Deploy ────────────────────────────────────────────────────────────────
echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║  🚀  Supabase Edge Function auto-deploy (pre-push)       ║"
echo "╚══════════════════════════════════════════════════════════╝"

if [[ "$DEPLOY_ALL" == true ]]; then
  echo "  → _shared/ changed — deploying ALL functions"
  echo ""

  # Enumerated from the filesystem, never hand-maintained. The previous version
  # was a hardcoded list, and the copy installed in .git/hooks had gone stale:
  # it still named gm-create-order / gm-order-status / gm-stripe-webhook, which
  # phase 1 deleted, and did not know about auth-discord. Deploying a function
  # whose directory no longer exists fails, and a failure here BLOCKS the push --
  # so a stale list does not degrade gracefully, it stops releases.
  ALL_FUNCTIONS=()
  while IFS= read -r d; do
    fn=$(basename "$d")
    [[ "$fn" == _* ]] && continue
    ALL_FUNCTIONS+=("$fn")
  done < <(find "${FUNCTIONS_DIR}" -mindepth 1 -maxdepth 1 -type d | sort)

  FAILED=()
  for fn in "${ALL_FUNCTIONS[@]}"; do
    printf "  Deploying %-35s" "${fn}..."
    if npx supabase functions deploy "$fn" 2>/dev/null 1>/dev/null; then
      echo "✅"
    else
      # Retry once (cold network, transient error)
      sleep 2
      if npx supabase functions deploy "$fn" 2>/dev/null 1>/dev/null; then
        echo "✅ (retry)"
      else
        echo "❌ FAILED"
        FAILED+=("$fn")
      fi
    fi
  done

  if [[ "${#FAILED[@]}" -gt 0 ]]; then
    echo ""
    echo "  ❌ Deploy failed for: ${FAILED[*]}"
    echo "  Push blocked. Fix the deploy errors and push again."
    echo "  Run:  npx supabase functions deploy ${FAILED[0]}"
    echo ""
    exit 1
  fi

else
  # Deduplicate
  mapfile -t DEPLOY_FUNCTIONS < <(printf '%s\n' "${DEPLOY_FUNCTIONS[@]}" | sort -u)

  echo "  → Deploying ${#DEPLOY_FUNCTIONS[@]} function(s): ${DEPLOY_FUNCTIONS[*]}"
  echo ""

  FAILED=()
  for fn in "${DEPLOY_FUNCTIONS[@]}"; do
    printf "  Deploying %-35s" "${fn}..."
    if npx supabase functions deploy "$fn" 2>/dev/null 1>/dev/null; then
      echo "✅"
    else
      sleep 2
      if npx supabase functions deploy "$fn" 2>/dev/null 1>/dev/null; then
        echo "✅ (retry)"
      else
        echo "❌ FAILED"
        FAILED+=("$fn")
      fi
    fi
  done

  if [[ "${#FAILED[@]}" -gt 0 ]]; then
    echo ""
    echo "  ❌ Deploy failed for: ${FAILED[*]}"
    echo "  Push blocked. Fix the deploy errors and push again."
    echo ""
    exit 1
  fi
fi

echo ""
echo "  ✅ All functions deployed successfully."
echo ""
exit 0
