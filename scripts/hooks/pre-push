#!/usr/bin/env bash
# scripts/hooks/pre-push
#
# This hook no longer deploys anything (short-term plan, phase 5).
#
# It used to deploy the changed Edge Functions from this machine on every push
# to main -- before CI had run, so a red build could already be live in
# production. Deploys now happen in the CI `deploy` job, after every check is
# green, through scripts/deploy-edge-functions.sh.
#
# What is left is a fast local check, so an obvious type error is caught before
# it costs a CI run. Skip it with `git push --no-verify` when you must.

set -euo pipefail

REMOTE="$1"   # remote name, unused

while read local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    echo "pre-push: type-checking before pushing to main..."
    npm run --silent type-check
    exit 0
  fi
done
exit 0
